{
  "name": "restaurant-cmv",
  "version": "1.0.0",
  "description": "Delivery app for restaurants",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--conditions=development tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-email-templates.mjs",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1164.0",
    "argon2": "^0.45.2",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "serverless-http": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/aws-lambda": "^8.10.164",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "imports": {
    "#bootstrap/*": {
      "development": "./src/bootstrap/*",
      "default": "./dist/bootstrap/*"
    },
    "#config/*": {
      "development": "./src/config/*",
      "default": "./dist/config/*"
    },
    "#delivery/*": {
      "development": "./src/delivery/*",
      "default": "./dist/delivery/*"
    },
    "#infrastructure/*": {
      "development": "./src/infrastructure/*",
      "default": "./dist/infrastructure/*"
    },
    "#modules/*": {
      "development": "./src/modules/*",
      "default": "./dist/modules/*"
    }
  }
}
