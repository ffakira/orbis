{
  "name": "restaurant-cmv",
  "version": "1.0.0",
  "description": "Delivery app for restaurants",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--conditions=development tsx watch src/server.ts",
    "build": "tsc6 -p tsconfig.json && node scripts/copy-email-templates.mjs",
    "start": "node dist/server.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.json\" \"*.ts\" \"**/*.mjs\" \".vscode/*.json\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.json\" \"*.ts\" \"**/*.mjs\" \".vscode/*.json\" \".github/**/*.yml\"",
    "typecheck": "tsc6 --noEmit -p tsconfig.json",
    "quality": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1164.0",
    "argon2": "^0.45.2",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "resend": "^6.37.0",
    "serverless-http": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/aws-lambda": "^8.10.164",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.2",
    "eslint-plugin-import-x": "^4.18.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "imports": {
    "#bootstrap/*": {
      "development": "./src/bootstrap/*",
      "default": "./dist/bootstrap/*"
    },
    "#config/*": {
      "development": "./src/config/*",
      "default": "./dist/config/*"
    },
    "#presentation/*": {
      "development": "./src/presentation/*",
      "default": "./dist/presentation/*"
    },
    "#infrastructure/*": {
      "development": "./src/infrastructure/*",
      "default": "./dist/infrastructure/*"
    },
    "#modules/*": {
      "development": "./src/modules/*",
      "default": "./dist/modules/*"
    }
  },
  "allowScripts": {
    "argon2@0.45.2": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.18.20": true
  }
}
